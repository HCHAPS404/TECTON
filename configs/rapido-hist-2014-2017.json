{
  "name": "rapido-hist-2014-2017",
  "data_dir": "data/raw",
  "strict": true,
  "seed": 42,
  "threads": 2,
  "model": {
    "family": "lgbm",
    "iterations": 800,
    "learning_rate": 0.01,
    "depth": -1,
    "max_leaf_nodes": 15,
    "min_samples_leaf": 200,
    "l2": 10.0,
    "max_features": 0.6,
    "subsample": 0.7
  },
  "features": {
    "use_history": true,
    "smoothing": 20.0,
    "external_files": [
      "data/external/divipola_coords.csv",
      "data/external/ideam_climatologia.csv",
      "data/external/dane_vulnerabilidad.csv",
      "data/external/dnp_capacidades.csv",
      "data/external/ungrd_hist_2014_2017.csv",
      "data/external/ungrd_hist_2014_2017_mes.csv"
    ],
    "spatial_k": 8,
    "external_derived": true,
    "drop": [
      "ext_dane_vulnerabilidad_imputado"
    ],
    "econ": {
      "garch": true,
      "official_lags": true,
      "dane": true,
      "ungrd": true
    }
  },
  "stress_test": false,
  "folds": [
    {
      "train_end": "2021-09-01",
      "valid_start": "2021-10-01",
      "valid_end": "2022-09-01"
    }
  ],
  "calibration": {
    "months": 12
  },
  "training": {
    "seeds": [
      42,
      7,
      123
    ]
  }
}
